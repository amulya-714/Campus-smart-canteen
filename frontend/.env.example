# Copy to .env and fill in. NEVER commit .env
# Homebrew Postgres: the default superuser is your macOS username (not "postgres"), usually with no password
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/campusbite
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=campusbite
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
# Python used by the Next.js API to run the forecast (venv created in README)
PYTHON_BIN=.venv/bin/python
